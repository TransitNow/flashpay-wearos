<resources>
    <!-- The trampoline and the flashlight both paint their own surface and must not flash a
         window background on the way in — that flash is the "logo screen" this app exists without. -->
    <style name="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- The menu is a real screen, so it gets a real opaque window. -->
    <style name="MenuTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
