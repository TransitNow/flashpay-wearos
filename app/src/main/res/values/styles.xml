<resources>
    <!-- The trampoline and the flashlight both paint their own surface and must not flash a
         window background on the way in — that flash is the "logo screen" this app exists without. -->
    <style name="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- The menu is a real screen, so it gets a real opaque window.
         Split base/child so values-v31 can add the branded-launch attributes without restating
         these; see the note there. -->
    <style name="MenuThemeBase">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="MenuTheme" parent="MenuThemeBase" />
</resources>
